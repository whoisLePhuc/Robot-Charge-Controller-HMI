    <lv_label x="20" y="152" text="Writing: 0%" scrollable="false" clickable="false" style_text_font="$progress_font" style_text_color="0xffffff" style_text_align="center" style_text_letter_space="0" width="380" height="16" long_mode="dots" name="ota_status" />
  </view>
