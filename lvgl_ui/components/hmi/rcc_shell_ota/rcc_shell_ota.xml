    <lv_label x="20" y="50" text="Target slot: writing to flash partition" scrollable="false" clickable="false" style_text_font="$body_font" style_text_color="0x94a3b8" style_text_align="center" style_text_letter_space="0" width="380" height="15" long_mode="dots" />
