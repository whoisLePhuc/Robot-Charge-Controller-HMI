<component>
  <api>
    <prop name="heading" type="string" default="Wi-Fi" />
    <prop name="subtitle" type="string" default="6 networks found" />
    <prop name="title_font" type="font" default="hmi_f14b" />
    <prop name="caption_font" type="font" default="hmi_f10" />
    <prop name="back_icon" type="image" default="hmi_icon_back_14" />
    <slot name="back" />
  </api>
  <view extends="lv_obj" width="480" height="42" clickable="false" scrollable="false" style_bg_opa="0%" style_pad_all="0" style_border_width="0" style_outline_width="0" style_shadow_width="0" style_radius="0">
