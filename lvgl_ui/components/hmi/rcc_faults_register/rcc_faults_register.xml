<component>
  <api>
    <prop name="card_x" type="int" default="0" />
    <prop name="card_height" type="int" default="162" />
    <prop name="register_title" type="string" default="FAULT REGISTER" />
    <prop name="register_mask" type="string" default="0x0000" />
    <prop name="register_value" type="string" default="0 active bits" />
    <prop name="register_note" type="string" default="No fault bits set" />
    <prop name="value_color" type="color" default="0x22c55e" />
    <prop name="caption_font" type="font" default="hmi_f10" />
    <prop name="title_font" type="font" default="hmi_f14b" />
  </api>
  <view x="$card_x" y="46" width="200" height="$card_height" clickable="false" scrollable="false" style_bg_color="0x111722" style_bg_opa="100%" style_radius="10" style_border_width="1" style_outline_width="0" style_shadow_width="0" style_pad_all="-1" style_border_color="0x1e293b" style_border_opa="100%" extends="lv_obj">
    <lv_label x="13" y="8" text="$register_title" style_text_font="$caption_font" style_text_color="0x94a3b8" clickable="false" scrollable="false" style_text_letter_space="1" />
    <lv_label x="111" y="8" text="$register_mask" style_text_font="$caption_font" style_text_color="0x94a3b8" clickable="false" scrollable="false" width="76" height="13" long_mode="dots" style_text_align="right" />
    <lv_label x="13" y="{23 + (card_height - 60) / 2}" text="$register_value" style_text_font="$title_font" style_text_color="$value_color" clickable="false" scrollable="false" width="174" height="16" long_mode="dots" style_text_align="left" />
    <lv_label x="13" y="{card_height - 20}" text="$register_note" style_text_font="$caption_font" style_text_color="0x94a3b8" clickable="false" scrollable="false" width="174" height="13" long_mode="dots" style_text_align="left" />
  </view>
</component>
