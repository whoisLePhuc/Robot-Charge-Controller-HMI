<component>
  <api>
    <prop name="left" type="int" default="0" />
    <prop name="button_width" type="int" default="408" />
    <prop name="label" type="string" default="STOP" />
    <prop name="glyph" type="image" default="hmi_icon_stop_16" />
    <prop name="bg" type="color" default="0xdc2626" />
    <prop name="fg" type="color" default="0xffffff" />
    <prop name="font" type="font" default="hmi_f16b" />
  </api>
  <view x="$left" y="0" width="$button_width" height="42" scrollable="false" clickable="true" style_pad_all="0" style_bg_color="$bg" style_bg_opa="100%" style_radius="10" style_border_width="1" style_outline_width="0" style_shadow_width="0" style_border_color="0xffffff" style_bg_opa-pressed="178" style_border_opa="36" extends="lv_button">
    <lv_label x="{button_width / 2 - 13}" y="12" text="$label" scrollable="false" clickable="false" style_text_font="$font" style_text_color="$fg" style_text_align="left" style_text_letter_space="1" name="action_label" />
    <lv_image x="{button_width / 2 - 37}" y="13" src="$glyph" clickable="false" scrollable="false" style_image_recolor="$fg" style_image_recolor_opa="100%" name="action_icon" />
  </view>
</component>
