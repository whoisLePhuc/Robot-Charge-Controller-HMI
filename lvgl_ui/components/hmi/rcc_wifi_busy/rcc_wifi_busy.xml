<component>
  <api>
    <prop name="title_font" type="font" default="hmi_f14b" />
    <prop name="caption_font" type="font" default="hmi_f10" />
    <prop name="data_font" type="font" default="hmi_f12" />
    <prop name="active_font" type="font" default="hmi_f12b" />
    <prop name="spinner_large" type="image" default="hmi_icon_spin_44" />
    <prop name="spinner_small" type="image" default="hmi_icon_spin_16" />
    <prop name="check_icon" type="image" default="hmi_icon_check_11" />
  </api>
  <view extends="lv_obj" width="480" height="320" clickable="false" scrollable="false" style_bg_opa="0%" style_pad_all="0" style_border_width="0" style_outline_width="0" style_shadow_width="0" style_radius="0">
    <lv_image name="spinner" src="$spinner_large" clickable="false" scrollable="false" x="218" y="50" style_image_recolor="0x38bdf8" style_image_recolor_opa="100%" />
    <lv_label text="Joining network..." clickable="false" scrollable="false" x="0" y="104" width="480" height="content" style_text_font="$title_font" style_text_color="0xf8fafc" style_text_align="center" />
    <lv_label text="Please wait, usually under 10 s" clickable="false" scrollable="false" x="0" y="127" width="480" height="content" style_text_font="$caption_font" style_text_color="0x94a3b8" style_text_align="center" />
    <lv_obj x="90" y="168" width="16" height="16" clickable="false" scrollable="false" style_pad_all="0" style_outline_width="0" style_shadow_width="0" hidden="false" style_bg_color="0x0a2617" style_bg_opa="100%" style_radius="8" style_border_width="0" style_border_color="0x2b3648" name="step_marker_0" />
    <lv_image src="$check_icon" clickable="false" scrollable="false" x="93" y="171" hidden="false" style_image_recolor="0x22c55e" style_image_recolor_opa="100%" name="step_check_0" />
    <lv_image name="step_spinner_0" src="$spinner_small" clickable="false" scrollable="false" x="90" y="168" hidden="true" style_image_recolor="0x38bdf8" style_image_recolor_opa="100%" />
    <lv_label name="step_0" text="Associating" clickable="false" scrollable="false" x="116" y="168" width="270" height="content" long_mode="dots" style_text_font="$data_font" style_text_color="0xcbd5e1" />
    <lv_obj x="90" y="190" width="16" height="16" clickable="false" scrollable="false" style_pad_all="0" style_outline_width="0" style_shadow_width="0" hidden="false" style_bg_color="0x0a2617" style_bg_opa="100%" style_radius="8" style_border_width="0" style_border_color="0x2b3648" name="step_marker_1" />
    <lv_image src="$check_icon" clickable="false" scrollable="false" x="93" y="193" hidden="false" style_image_recolor="0x22c55e" style_image_recolor_opa="100%" name="step_check_1" />
    <lv_image name="step_spinner_1" src="$spinner_small" clickable="false" scrollable="false" x="90" y="190" hidden="true" style_image_recolor="0x38bdf8" style_image_recolor_opa="100%" />
    <lv_label name="step_1" text="Authenticating" clickable="false" scrollable="false" x="116" y="190" width="270" height="content" long_mode="dots" style_text_font="$data_font" style_text_color="0xcbd5e1" />
    <lv_obj x="90" y="212" width="16" height="16" clickable="false" scrollable="false" style_pad_all="0" style_outline_width="0" style_shadow_width="0" hidden="true" style_bg_color="0x0a2617" style_bg_opa="100%" style_radius="8" style_border_width="0" style_border_color="0x2b3648" name="step_marker_2" />
    <lv_image src="$check_icon" clickable="false" scrollable="false" x="93" y="215" hidden="true" style_image_recolor="0x22c55e" style_image_recolor_opa="100%" name="step_check_2" />
    <lv_image name="step_spinner_2" src="$spinner_small" clickable="false" scrollable="false" x="90" y="212" hidden="false" style_image_recolor="0x38bdf8" style_image_recolor_opa="100%" />
    <lv_label name="step_2" text="Obtaining IP address" clickable="false" scrollable="false" x="116" y="212" width="270" height="content" long_mode="dots" style_text_font="$active_font" style_text_color="0xf8fafc" />
    <lv_button x="150" y="268" width="180" height="40" clickable="true" style_radius="10" style_border_width="1" style_bg_opa="100%" style_bg_color="0x172030" style_border_color="0x1e293b" style_pad_top="-1" style_pad_bottom="-1" style_pad_left="-1" style_pad_right="-1" scrollable="false" style_shadow_width="0" style_outline_width="0" name="cancel" style_bg_opa-pressed="70%">
      <lv_label x="0" y="13" width="180" height="13" clickable="false" style_text_font="$active_font" style_text_color="0xcbd5e1" scrollable="false" text="CANCEL" long_mode="dots" style_text_align="center" style_text_letter_space="1" />
    </lv_button>
  </view>
</component>
