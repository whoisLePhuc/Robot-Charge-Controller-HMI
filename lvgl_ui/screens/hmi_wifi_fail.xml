<screen>
  <view style_bg_color="0x090d14" style_bg_opa="100%" style_pad_all="0" style_border_width="0" scrollable="false">
    <rcc_wifi_header heading="Connection failed" subtitle="MSVN-Office">
      <rcc_wifi_header-back>
        <lv_obj-screen_create_event screen="hmi_wifi_list" trigger="clicked" />
      </rcc_wifi_header-back>
    </rcc_wifi_header>
    <rcc_wifi_fail failure_title="Wrong password" failure_text="The access point rejected the credentials. Check the password and try again." attempt_text="1" signal_text="-61 dBm" show_password_hint="true">
      <rcc_wifi_fail-choose_other>
        <lv_obj-screen_create_event screen="hmi_wifi_list" trigger="clicked" />
      </rcc_wifi_fail-choose_other>
      <rcc_wifi_fail-retry>
        <lv_obj-screen_create_event screen="hmi_wifi_pass" trigger="clicked" />
      </rcc_wifi_fail-retry>
    </rcc_wifi_fail>
  </view>
</screen>
